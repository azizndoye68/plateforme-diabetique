# Copie ce fichier en docker/.env et remplace les valeurs d'exemple.
POSTGRES_USER=diabete_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
RABBITMQ_DEFAULT_USER=diabete_app
RABBITMQ_DEFAULT_PASS=replace-with-another-long-random-password
JWT_SECRET=replace-with-the-same-long-random-secret-for-auth-and-communication
AUTH_INTERNAL_API_KEY=replace-with-a-long-random-internal-api-key

# Dossier contenant les fichiers de configuration Spring externalisés.
LOCAL_CONFIG_PATH=C:/Users/DELL/config-data-local

# URL publique vue par le navigateur. Pour TLS, utiliser https://votre-domaine.
REACT_APP_API_BASE_URL=http://localhost:3000
